#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

include /usr/share/dpkg/architecture.mk

BUILDDIR = $(CURDIR)/obj-$(DEB_HOST_GNU_TYPE)

%:
	dh $@ --with python3 --buildsystem=cmake

# Debian installs extension modules into the unversioned dist-packages
# directory; the upstream default is /usr/lib/python<X>.<Y>/dist-packages.
override_dh_auto_configure:
	dh_auto_configure -- \
		-DPYTHON_SITE_PACKAGES_INSTALL_DIR=/usr/lib/python3/dist-packages

# The suite imports its cases as top level modules, so run it from tests/.
override_dh_auto_test:
	cd $(CURDIR)/tests && PYTHONPATH=$(BUILDDIR) python3 PyKDLtest.py
